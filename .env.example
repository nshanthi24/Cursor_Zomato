# Copy to .env for local runs. .env is gitignored.
# LLM_API_KEY is a Groq key, read from the environment, and must stay out of source files.

DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
DATASET_REVISION=5738e9eda2fad49ad51c6e0ed26e761d9b947133
CATALOG_PATH=data/catalog.parquet
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1500
CANDIDATE_LIMIT=15
RESULT_LIMIT=5
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Set false only if local Python cannot verify TLS (corporate proxy / missing CA).
LLM_SSL_VERIFY=true

# Comma-separated browser origins allowed to call the API (Vercel + local static preview).
# Example: https://thindi.vercel.app,http://localhost:3000
CORS_ORIGINS=
